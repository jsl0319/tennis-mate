generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
}

enum ExperienceRange {
  UNDER_3_MONTHS
  MONTHS_3_TO_6
  MONTHS_6_TO_12
  YEARS_1_TO_2
  YEARS_2_PLUS
}

enum RallyLevel {
  STARTING
  SHORT_RALLY
  COMFORTABLE_RALLY
  STANDARD_RALLY
}

enum GameExperience {
  NONE
  KNOWS_RULES
  PLAYED_FEW
  CAN_PLAY
}

enum PlayPurpose {
  CASUAL_HIT
  RALLY_PRACTICE
  STROKE_PRACTICE
  GAME_INTRO
  GAME
}

enum RegionType {
  CITY
  DISTRICT
}

enum CourtSource {
  EXTERNAL_RESERVED
  COURT_TBD
  PARTNER_COURT
}

enum PartnerPreference {
  COMPLETE_BEGINNER_WELCOME
  SIMILAR_LEVEL
  GAME_CAPABLE
}

enum MatchStatus {
  OPEN
  CLOSED
  COMPLETED
  EXPIRED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  CANCELLED
}

enum CourtImageUploadStatus {
  PENDING
  ATTACHED
  CLEANUP_PENDING
  DELETED
}

enum CourtSlotVisibility {
  PRIVATE
  PUBLIC
}

enum CourtSlotStatus {
  DRAFT
  AVAILABLE
  ALLOCATED
  ENDED
  BLOCKED
  CANCELLED
}

enum SlotStatusChangeActor {
  OPERATOR
  SESSION_HOST
  SYSTEM
  ADMIN
}

enum OperatorApplicationStatus {
  DRAFT
  VERIFYING
  DRAFT_ACCESS_GRANTED
  REVIEW_REQUIRED
  UNDER_REVIEW
  CHANGES_REQUESTED
  PUBLISH_APPROVED
  REJECTED
  SUSPENDED
}

enum BusinessVerificationStatus {
  PENDING
  VERIFIED
  MISMATCH
  UNAVAILABLE
}

enum VenueVerificationStatus {
  PENDING
  MATCHED
  REVIEW_REQUIRED
  UNAVAILABLE
}

enum VerificationAttemptKind {
  BUSINESS
  VENUE
}

enum VerificationAttemptResult {
  VERIFIED
  MISMATCH
  UNAVAILABLE
  REVIEW_REQUIRED
  PENDING
}

model User {
  id                    String     @id @default(uuid()) @db.Uuid
  nickname              String     @unique @db.VarChar(12)
  status                UserStatus @default(ACTIVE)
  nicknameConfirmedAt   DateTime?  @map("nickname_confirmed_at") @db.Timestamptz(6)
  onboardingCompletedAt DateTime?  @map("onboarding_completed_at") @db.Timestamptz(6)
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  authAccounts         AuthAccount[]
  tennisProfile        TennisProfile?
  apiRateLimit         ApiRateLimit?
  hostedMatches        Match[]                    @relation("MatchHost")
  matchApplications    MatchApplication[]
  courtImageUploads    CourtImageUpload[]
  operatorApplications CourtOperatorApplication[] @relation("OperatorApplicationApplicant")
  courtSlotStatusHistories CourtSlotStatusHistory[] @relation("CourtSlotStatusActor")

  @@map("users")
}

model AuthAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String   @db.VarChar(30)
  providerAccountId String   @map("provider_account_id") @db.VarChar(191)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

model TennisProfile {
  id                  String          @id @default(uuid()) @db.Uuid
  userId              String          @unique @map("user_id") @db.Uuid
  experienceRange     ExperienceRange @map("experience_range")
  rallyLevel          RallyLevel      @map("rally_level")
  gameExperience      GameExperience  @map("game_experience")
  skillLabel          String?         @map("skill_label") @db.VarChar(30)
  nearbyRegionAllowed Boolean         @default(true) @map("nearby_region_allowed")
  version             Int             @default(1)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  regions  TennisProfileRegion[]
  purposes TennisProfilePurpose[]

  @@map("tennis_profiles")
}

model Region {
  code       String     @id @db.VarChar(30)
  parentCode String?    @map("parent_code") @db.VarChar(30)
  name       String     @db.VarChar(50)
  shortName  String?    @map("short_name") @db.VarChar(30)
  type       RegionType
  active     Boolean    @default(true)

  parent   Region?               @relation("RegionHierarchy", fields: [parentCode], references: [code], onDelete: Restrict)
  children Region[]              @relation("RegionHierarchy")
  profiles TennisProfileRegion[]
  matches  Match[]
  courts   Court[]

  @@unique([parentCode, name])
  @@index([parentCode, active])
  @@map("regions")
}

model TennisProfileRegion {
  tennisProfileId String  @map("tennis_profile_id") @db.Uuid
  regionCode      String  @map("region_code") @db.VarChar(30)
  isPrimary       Boolean @default(true) @map("is_primary")

  tennisProfile TennisProfile @relation(fields: [tennisProfileId], references: [id], onDelete: Cascade)
  region        Region        @relation(fields: [regionCode], references: [code], onDelete: Restrict)

  @@id([tennisProfileId, regionCode])
  @@index([regionCode, tennisProfileId])
  @@map("tennis_profile_regions")
}

model TennisProfilePurpose {
  tennisProfileId String      @map("tennis_profile_id") @db.Uuid
  purpose         PlayPurpose

  tennisProfile TennisProfile @relation(fields: [tennisProfileId], references: [id], onDelete: Cascade)

  @@id([tennisProfileId, purpose])
  @@map("tennis_profile_purposes")
}

model ApiRateLimit {
  userId          String   @id @map("user_id") @db.Uuid
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(6)
  requestCount    Int      @default(0) @map("request_count")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_rate_limits")
}

model Match {
  id                   String            @id @default(uuid()) @db.Uuid
  hostUserId           String            @map("host_user_id") @db.Uuid
  clientRequestId      String            @map("client_request_id") @db.Uuid
  regionCode           String            @map("region_code") @db.VarChar(30)
  title                String            @db.VarChar(80)
  startsAt             DateTime          @map("starts_at") @db.Timestamptz(6)
  endsAt               DateTime          @map("ends_at") @db.Timestamptz(6)
  courtSource          CourtSource       @default(EXTERNAL_RESERVED) @map("court_source")
  externalCourtName    String?           @map("external_court_name") @db.VarChar(100)
  externalCourtAddress String?           @map("external_court_address") @db.VarChar(255)
  externalCourtNumber  String?           @map("external_court_number") @db.VarChar(50)
  externalCourtImageUploadId String?     @unique @map("external_court_image_upload_id") @db.Uuid
  courtSlotId            String?           @unique @map("court_slot_id") @db.Uuid
  recruitCount         Int               @map("recruit_count")
  partnerPreference    PartnerPreference @map("partner_preference")
  totalCourtFeeKrw     Int?              @map("total_court_fee_krw")
  additionalCostNote   String?           @map("additional_cost_note") @db.VarChar(200)
  introduction         String?           @db.VarChar(300)
  contactOpenChatUrl   String            @map("contact_open_chat_url") @db.VarChar(500)
  status               MatchStatus       @default(OPEN)
  version              Int               @default(1)
  closedAt             DateTime?         @map("closed_at") @db.Timestamptz(6)
  completedAt          DateTime?         @map("completed_at") @db.Timestamptz(6)
  expiredAt            DateTime?         @map("expired_at") @db.Timestamptz(6)
  cancelledAt          DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason   String?           @map("cancellation_reason") @db.VarChar(200)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  host         User               @relation("MatchHost", fields: [hostUserId], references: [id], onDelete: Restrict)
  region       Region             @relation(fields: [regionCode], references: [code], onDelete: Restrict)
  purposes     MatchPurpose[]
  applications MatchApplication[]
  externalCourtImageUpload CourtImageUpload? @relation("ExternalCourtImage", fields: [externalCourtImageUploadId], references: [id], onDelete: Restrict)
  courtSlot    CourtSlot?          @relation(fields: [courtSlotId], references: [id], onDelete: Restrict)

  @@unique([hostUserId, clientRequestId])
  @@index([status, startsAt])
  @@index([regionCode, status, startsAt])
  @@index([hostUserId, status, startsAt])
  @@map("matches")
}

model CourtImageUpload {
  id               String                 @id @default(uuid()) @db.Uuid
  ownerUserId      String                 @map("owner_user_id") @db.Uuid
  privateObjectRef String                 @unique @map("private_object_ref") @db.VarChar(500)
  contentType      String                 @map("content_type") @db.VarChar(100)
  byteSize         Int                    @map("byte_size")
  status           CourtImageUploadStatus @default(PENDING)
  attachedAt       DateTime?              @map("attached_at") @db.Timestamptz(6)
  cleanupClaimedAt DateTime?              @map("cleanup_claimed_at") @db.Timestamptz(6)
  deletedAt        DateTime?              @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner         User   @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  attachedMatch Match? @relation("ExternalCourtImage")

  @@index([ownerUserId, status, createdAt])
  @@index([status, createdAt])
  @@map("court_image_uploads")
}

model MatchPurpose {
  matchId String      @map("match_id") @db.Uuid
  purpose PlayPurpose

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@id([matchId, purpose])
  @@index([purpose, matchId])
  @@map("match_purposes")
}

model MatchApplication {
  id                     String            @id @default(uuid()) @db.Uuid
  matchId                String            @map("match_id") @db.Uuid
  applicantUserId        String            @map("applicant_user_id") @db.Uuid
  status                 ApplicationStatus @default(PENDING)
  message                String?           @db.VarChar(200)
  profileSnapshot        Json              @map("profile_snapshot") @db.JsonB
  profileSnapshotVersion Int               @default(1) @map("profile_snapshot_version")
  decidedAt              DateTime?         @map("decided_at") @db.Timestamptz(6)
  withdrawnAt            DateTime?         @map("withdrawn_at") @db.Timestamptz(6)
  cancelledAt            DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  match         Match @relation(fields: [matchId], references: [id], onDelete: Restrict)
  applicantUser User  @relation(fields: [applicantUserId], references: [id], onDelete: Restrict)

  @@unique([matchId, applicantUserId])
  @@index([matchId, status, createdAt])
  @@index([applicantUserId, status, createdAt(sort: Desc)])
  @@map("match_applications")
}

model CourtOperatorApplication {
  id                             String                     @id @default(uuid()) @db.Uuid
  applicantUserId                String                     @map("applicant_user_id") @db.Uuid
  status                         OperatorApplicationStatus  @default(DRAFT)
  businessName                   String                     @map("business_name") @db.VarChar(100)
  businessRegistrationNumberHash String                     @map("business_registration_number_hash") @db.VarChar(128)
  verificationInputRef           String?                    @map("verification_input_ref") @db.VarChar(255)
  businessVerificationStatus     BusinessVerificationStatus @default(PENDING) @map("business_verification_status")
  venueVerificationStatus        VenueVerificationStatus    @default(PENDING) @map("venue_verification_status")
  venueName                      String                     @map("venue_name") @db.VarChar(100)
  venueAddress                   String                     @map("venue_address") @db.VarChar(255)
  normalizedVenueKey             String                     @map("normalized_venue_key") @db.VarChar(255)
  verificationFailureCode        String?                    @map("verification_failure_code") @db.VarChar(60)
  submittedAt                    DateTime?                  @map("submitted_at") @db.Timestamptz(6)
  verifiedAt                     DateTime?                  @map("verified_at") @db.Timestamptz(6)
  publishApprovedAt              DateTime?                  @map("publish_approved_at") @db.Timestamptz(6)
  createdAt                      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                      DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  applicant            User                                     @relation("OperatorApplicationApplicant", fields: [applicantUserId], references: [id], onDelete: Restrict)
  verificationAttempts OperatorApplicationVerificationAttempt[]
  court                Court?

  @@index([applicantUserId, createdAt(sort: Desc)])
  @@index([businessRegistrationNumberHash, status])
  @@index([normalizedVenueKey, status])
  @@map("court_operator_applications")
}

model Court {
  id                    String   @id @default(uuid()) @db.Uuid
  operatorApplicationId String   @unique @map("operator_application_id") @db.Uuid
  regionCode            String   @map("region_code") @db.VarChar(30)
  name                  String   @db.VarChar(100)
  address               String   @db.VarChar(255)
  normalizedVenueKey    String   @unique @map("normalized_venue_key") @db.VarChar(255)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  operatorApplication CourtOperatorApplication @relation(fields: [operatorApplicationId], references: [id], onDelete: Restrict)
  region              Region                   @relation(fields: [regionCode], references: [code], onDelete: Restrict)
  units               CourtUnit[]

  @@index([regionCode, createdAt])
  @@map("courts")
}

model CourtUnit {
  id        String   @id @default(uuid()) @db.Uuid
  courtId   String   @map("court_id") @db.Uuid
  name      String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  court Court       @relation(fields: [courtId], references: [id], onDelete: Restrict)
  slots CourtSlot[]

  @@unique([courtId, name])
  @@index([courtId])
  @@map("court_units")
}

model CourtSlot {
  id                  String              @id @default(uuid()) @db.Uuid
  courtUnitId         String              @map("court_unit_id") @db.Uuid
  startsAt            DateTime            @map("starts_at") @db.Timestamptz(6)
  endsAt              DateTime            @map("ends_at") @db.Timestamptz(6)
  priceKrw            Int                 @map("price_krw")
  maxParticipantCount Int                 @map("max_participant_count")
  visibility          CourtSlotVisibility @default(PRIVATE)
  status              CourtSlotStatus     @default(DRAFT)
  publishedAt         DateTime?           @map("published_at") @db.Timestamptz(6)
  statusChangedAt     DateTime            @default(now()) @map("status_changed_at") @db.Timestamptz(6)
  usageNote           String?             @map("usage_note") @db.VarChar(500)
  version             Int                 @default(1)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  courtUnit      CourtUnit               @relation(fields: [courtUnitId], references: [id], onDelete: Restrict)
  match          Match?
  statusHistory  CourtSlotStatusHistory[]

  @@index([courtUnitId, startsAt])
  @@index([visibility, status, startsAt])
  @@map("court_slots")
}

model CourtSlotStatusHistory {
  id          String                @id @default(uuid()) @db.Uuid
  courtSlotId String                @map("court_slot_id") @db.Uuid
  fromStatus  CourtSlotStatus?      @map("from_status")
  toStatus    CourtSlotStatus       @map("to_status")
  actor       SlotStatusChangeActor
  actorUserId String?               @map("actor_user_id") @db.Uuid
  reasonCode  String                @map("reason_code") @db.VarChar(60)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  courtSlot CourtSlot @relation(fields: [courtSlotId], references: [id], onDelete: Cascade)
  actorUser User?     @relation("CourtSlotStatusActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([courtSlotId, createdAt])
  @@map("court_slot_status_histories")
}

model OperatorApplicationVerificationAttempt {
  id                 String                    @id @default(uuid()) @db.Uuid
  applicationId      String                    @map("application_id") @db.Uuid
  kind               VerificationAttemptKind
  result             VerificationAttemptResult
  safeFailureCode    String?                   @map("safe_failure_code") @db.VarChar(60)
  providerRequestRef String?                   @map("provider_request_ref") @db.VarChar(120)
  attemptedAt        DateTime                  @default(now()) @map("attempted_at") @db.Timestamptz(6)

  application CourtOperatorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, attemptedAt(sort: Desc)])
  @@map("operator_application_verification_attempts")
}
