generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
}

enum ExperienceRange {
  UNDER_3_MONTHS
  MONTHS_3_TO_6
  MONTHS_6_TO_12
  YEARS_1_TO_2
  YEARS_2_PLUS
}

enum RallyLevel {
  STARTING
  SHORT_RALLY
  COMFORTABLE_RALLY
  STANDARD_RALLY
}

enum GameExperience {
  NONE
  KNOWS_RULES
  PLAYED_FEW
  CAN_PLAY
}

enum PlayPurpose {
  CASUAL_HIT
  RALLY_PRACTICE
  STROKE_PRACTICE
  GAME_INTRO
  GAME
}

enum RegionType {
  CITY
  DISTRICT
}

enum CourtSource {
  EXTERNAL_RESERVED
}

enum PartnerPreference {
  COMPLETE_BEGINNER_WELCOME
  SIMILAR_LEVEL
  GAME_CAPABLE
}

enum MatchStatus {
  OPEN
  CLOSED
  COMPLETED
  EXPIRED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  CANCELLED
}

model User {
  id                   String         @id @default(uuid()) @db.Uuid
  nickname             String         @unique @db.VarChar(12)
  status               UserStatus     @default(ACTIVE)
  nicknameConfirmedAt  DateTime?      @map("nickname_confirmed_at") @db.Timestamptz(6)
  onboardingCompletedAt DateTime?     @map("onboarding_completed_at") @db.Timestamptz(6)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  authAccounts AuthAccount[]
  tennisProfile TennisProfile?
  hostedMatches Match[]           @relation("MatchHost")
  matchApplications MatchApplication[]

  @@map("users")
}

model AuthAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String   @db.VarChar(30)
  providerAccountId String   @map("provider_account_id") @db.VarChar(191)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

model TennisProfile {
  id                  String         @id @default(uuid()) @db.Uuid
  userId              String         @unique @map("user_id") @db.Uuid
  experienceRange     ExperienceRange @map("experience_range")
  rallyLevel          RallyLevel     @map("rally_level")
  gameExperience      GameExperience @map("game_experience")
  skillLabel          String?        @map("skill_label") @db.VarChar(30)
  nearbyRegionAllowed Boolean        @default(true) @map("nearby_region_allowed")
  version             Int            @default(1)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  regions  TennisProfileRegion[]
  purposes TennisProfilePurpose[]

  @@map("tennis_profiles")
}

model Region {
  code      String       @id @db.VarChar(30)
  parentCode String?     @map("parent_code") @db.VarChar(30)
  name      String       @db.VarChar(50)
  shortName String?      @map("short_name") @db.VarChar(30)
  type      RegionType
  active    Boolean      @default(true)

  parent   Region?                 @relation("RegionHierarchy", fields: [parentCode], references: [code], onDelete: Restrict)
  children Region[]                @relation("RegionHierarchy")
  profiles TennisProfileRegion[]
  matches  Match[]

  @@unique([parentCode, name])
  @@index([parentCode, active])
  @@map("regions")
}

model TennisProfileRegion {
  tennisProfileId String  @map("tennis_profile_id") @db.Uuid
  regionCode      String  @map("region_code") @db.VarChar(30)
  isPrimary       Boolean @default(true) @map("is_primary")

  tennisProfile TennisProfile @relation(fields: [tennisProfileId], references: [id], onDelete: Cascade)
  region        Region        @relation(fields: [regionCode], references: [code], onDelete: Restrict)

  @@id([tennisProfileId, regionCode])
  @@index([regionCode, tennisProfileId])
  @@map("tennis_profile_regions")
}

model TennisProfilePurpose {
  tennisProfileId String      @map("tennis_profile_id") @db.Uuid
  purpose         PlayPurpose

  tennisProfile TennisProfile @relation(fields: [tennisProfileId], references: [id], onDelete: Cascade)

  @@id([tennisProfileId, purpose])
  @@map("tennis_profile_purposes")
}

model Match {
  id                    String            @id @default(uuid()) @db.Uuid
  hostUserId            String            @map("host_user_id") @db.Uuid
  clientRequestId       String            @map("client_request_id") @db.Uuid
  regionCode            String            @map("region_code") @db.VarChar(30)
  title                 String            @db.VarChar(80)
  startsAt              DateTime          @map("starts_at") @db.Timestamptz(6)
  endsAt                DateTime          @map("ends_at") @db.Timestamptz(6)
  courtSource           CourtSource       @default(EXTERNAL_RESERVED) @map("court_source")
  externalCourtName     String            @map("external_court_name") @db.VarChar(100)
  externalCourtAddress  String            @map("external_court_address") @db.VarChar(255)
  externalCourtNumber   String?           @map("external_court_number") @db.VarChar(50)
  recruitCount          Int               @map("recruit_count")
  partnerPreference     PartnerPreference @map("partner_preference")
  totalCourtFeeKrw      Int               @map("total_court_fee_krw")
  additionalCostNote    String?           @map("additional_cost_note") @db.VarChar(200)
  introduction          String?           @db.VarChar(300)
  contactOpenChatUrl    String            @map("contact_open_chat_url") @db.VarChar(500)
  status                MatchStatus       @default(OPEN)
  version               Int               @default(1)
  closedAt              DateTime?         @map("closed_at") @db.Timestamptz(6)
  completedAt           DateTime?         @map("completed_at") @db.Timestamptz(6)
  expiredAt             DateTime?         @map("expired_at") @db.Timestamptz(6)
  cancelledAt           DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason    String?           @map("cancellation_reason") @db.VarChar(200)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  host         User               @relation("MatchHost", fields: [hostUserId], references: [id], onDelete: Restrict)
  region       Region             @relation(fields: [regionCode], references: [code], onDelete: Restrict)
  purposes     MatchPurpose[]
  applications MatchApplication[]

  @@unique([hostUserId, clientRequestId])
  @@index([status, startsAt])
  @@index([regionCode, status, startsAt])
  @@index([hostUserId, status, startsAt])
  @@map("matches")
}

model MatchPurpose {
  matchId String      @map("match_id") @db.Uuid
  purpose PlayPurpose

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@id([matchId, purpose])
  @@index([purpose, matchId])
  @@map("match_purposes")
}

model MatchApplication {
  id                     String            @id @default(uuid()) @db.Uuid
  matchId                String            @map("match_id") @db.Uuid
  applicantUserId        String            @map("applicant_user_id") @db.Uuid
  status                 ApplicationStatus @default(PENDING)
  message                String?           @db.VarChar(200)
  profileSnapshot        Json              @map("profile_snapshot") @db.JsonB
  profileSnapshotVersion Int               @default(1) @map("profile_snapshot_version")
  decidedAt              DateTime?         @map("decided_at") @db.Timestamptz(6)
  withdrawnAt            DateTime?         @map("withdrawn_at") @db.Timestamptz(6)
  cancelledAt            DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  match         Match @relation(fields: [matchId], references: [id], onDelete: Restrict)
  applicantUser User  @relation(fields: [applicantUserId], references: [id], onDelete: Restrict)

  @@unique([matchId, applicantUserId])
  @@index([matchId, status, createdAt])
  @@index([applicantUserId, status, createdAt(sort: Desc)])
  @@map("match_applications")
}
